{
  "name": "@servor/agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build:linux-x64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/servor-agent-linux-x64",
    "build:linux-arm64": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile dist/servor-agent-linux-arm64",
    "build:linux-x64-musl": "bun build src/index.ts --compile --target=bun-linux-x64-musl --outfile dist/servor-agent-linux-x64-musl",
    "build:linux-arm64-musl": "bun build src/index.ts --compile --target=bun-linux-arm64-musl --outfile dist/servor-agent-linux-arm64-musl",
    "build:darwin-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/servor-agent-darwin-x64",
    "build:darwin-arm64": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/servor-agent-darwin-arm64",
    "build:windows-x64": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/servor-agent-windows-x64.exe",
    "build": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:linux-x64-musl && bun run build:linux-arm64-musl && bun run build:darwin-x64 && bun run build:darwin-arm64 && bun run build:windows-x64"
  }
}
